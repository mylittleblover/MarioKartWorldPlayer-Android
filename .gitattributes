# Vendored sources are pinned by SHA256 and must never be line-ending converted.
# Without these rules a Windows checkout (core.autocrlf=true) rewrites CRLF and
# breaks the pinned digests in third_party/*/CMakeLists.txt.
third_party/** -text
app/src/main/cpp/** -text

*.tar.gz binary
*.png binary
*.7z binary
