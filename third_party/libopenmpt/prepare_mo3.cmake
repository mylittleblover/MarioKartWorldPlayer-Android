# Strict MO3 source admission: upstream's tolerant sample recovery must not
# publish silently missing audio. Apply only to the verified extracted archive.
set(mo3_loader "${source_root}/soundlib/Load_mo3.cpp")
file(READ "${mo3_loader}" text)
if(NOT text MATCHES "PLAYER2: strict MO3 sample admission")
    set(before "if(!file.Read(nextByte)) \\\n\t\t\tbreak;")
    set(after "if(!file.Read(nextByte)) \\\n\t\t\tthrow std::runtime_error(\"PLAYER2: truncated MO3 bitstream\");")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 bitstream patch context mismatch")
    endif()
    string(REPLACE "${before}" "${after}" text "${text}")
    set(before "\t\tAddToLog(LogWarning, U_(\"Some compressed samples could not be loaded because they use an unsupported codec.\"));")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 codec refusal patch context mismatch")
    endif()
    string(REPLACE "${before}" "\t\t// PLAYER2: strict MO3 sample admission.\n\t\treturn false;" text "${text}")
    set(before "\t\t\t\tstb_vorbis_close(vorb);")
    string(REPLACE "${before}" "${before}\n\t\t\t\tif(offset < smpHeader.length) return false;" text "${text}")
    set(before "\t\t\t\tLimitMax(sample.nLength, smpHeader.length);")
    string(REPLACE "${before}" "\t\t\t\tif(sample.nLength < smpHeader.length) return false;\n${before}" text "${text}")
    file(WRITE "${mo3_loader}" "${text}")
endif()

file(READ "${mo3_loader}" text)
if(NOT text MATCHES "PLAYER2: MO3 declared channel coherence")
    set(before "\t\t\t\t\tLimitMax(decodedSamples, mpt::saturate_cast<int>(sample.nLength - offset));")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 Vorbis channel patch context mismatch")
    endif()
    set(after "${before}\n\t\t\t\t\t// PLAYER2: MO3 declared channel coherence.\n\t\t\t\t\tif(decodedSamples > 0 && channels != sample.GetNumChannels()) { stb_vorbis_close(vorb); return false; }")
    string(REPLACE "${before}" "${after}" text "${text}")
    set(before "\t\t\t\tif(encoderDelay > 0 && encoderDelay < sample.GetSampleSizeInBytes())")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 MPEG channel patch context mismatch")
    endif()
    string(REPLACE "${before}" "\t\t\t\tif(sample.GetNumChannels() != ((smpHeader.flags & MO3Sample::smpStereo) ? 2u : 1u)) return false;\n${before}" text "${text}")
    file(WRITE "${mo3_loader}" "${text}")
endif()

# MPEG sample chunks may contain far more audio than their declared Module
# sample. Bound temporary decoding too, rather than only final retained PCM.
set(mpeg_loader "${source_root}/soundlib/SampleFormatMP3.cpp")
file(READ "${mpeg_loader}" text)
if(NOT text MATCHES "PLAYER2: bounded MO3 MPEG prefix")
    set(before "\tstd::vector<int16> raw_sample_data;")
    set(after "${before}\n\t// PLAYER2: bounded MO3 MPEG prefix plus maximum uint16 encoder-delay bytes.\n\tconst uint64 player2Mo3Frames = static_cast<uint64>(Samples[sample].nLength) + 32768u;")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 MPEG allocation patch context mismatch")
    endif()
    string(REPLACE "${before}" "${after}" text "${text}")
    set(before "\t} while(bytes_left > 0);")
    string(FIND "${text}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Pinned MO3 MPEG prefix patch context mismatch")
    endif()
    string(REPLACE "${before}" "\t} while(bytes_left > 0 && (!mo3Decode || channels == 0 || raw_sample_data.size() / channels < player2Mo3Frames));" text "${text}")
    file(WRITE "${mpeg_loader}" "${text}")
endif()
