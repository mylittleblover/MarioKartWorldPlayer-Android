    <!-- #24 全10問 スペシャルカップ解放チャレンジ -->
    <string name="quiz_title">JukeKart スペシャルカップ解放チャレンジ</string>
    <string name="quiz_subtitle">全10問すべてに正解すると、謎のコース解放演出へ進めます。</string>
    <string name="quiz_progress_fmt">%1$d / %2$d</string>
    <string name="quiz_final_challenge_badge">最終チャレンジ</string>
    <string name="quiz_wrong_feedback">不正解です。もう一度挑戦してみましょう！</string>
    <string name="quiz_retry_button">もう一度答える</string>
    <string name="quiz_congrats_title">全問正解おめでとうございます！</string>
    <string name="quiz_congrats_body">謎のコース解放演出の準備が整いました。演出を最後まで視聴すると正式に解放されます。</string>
    <string name="quiz_ready_title">解放条件を達成しました！</string>
    <string name="quiz_ready_body">謎のコースの解放演出を開始できます。今すぐ演出を見て最後のグランプリを解放しましょう。</string>
    <string name="quiz_enter_ceremony_button">演出を見る</string>

    <string name="quiz_q1_question">『マリオカート ワールド』の発売日はいつですか？</string>
    <string name="quiz_q1_a">2024年6月5日</string>
    <string name="quiz_q1_b">2025年4月2日</string>
    <string name="quiz_q1_c">2025年6月5日</string>
    <string name="quiz_q1_d">2025年7月17日</string>

    <string name="quiz_q2_question">発売時点でグランプリのカップはいくつありますか？</string>
    <string name="quiz_q2_a">6個</string>
    <string name="quiz_q2_b">8個</string>
    <string name="quiz_q2_c">10個</string>
    <string name="quiz_q2_d">12個</string>

    <string name="quiz_q3_question">発売時点でサバイバルのラリールートはいくつありますか？</string>
    <string name="quiz_q3_a">8ルート</string>
    <string name="quiz_q3_b">10ルート</string>
    <string name="quiz_q3_c">12ルート</string>
    <string name="quiz_q3_d">16ルート</string>

    <string name="quiz_q4_question">1つのグランプリカップにはいくつのコースが含まれますか？</string>
    <string name="quiz_q4_a">3コース</string>
    <string name="quiz_q4_b">5コース</string>
    <string name="quiz_q4_c">6コース</string>
    <string name="quiz_q4_d">4コース</string>

    <string name="quiz_q5_question">『マリオカート ワールド』で1レースに同時参加できる最大レーサー数は何人ですか？</string>
    <string name="quiz_q5_a">8人</string>
    <string name="quiz_q5_b">12人</string>
    <string name="quiz_q5_c">24人</string>
    <string name="quiz_q5_d">32人</string>

    <string name="quiz_q6_question">標準の24人サバイバルでは、脱落チェックポイントを通過するごとに何人が脱落しますか？</string>
    <string name="quiz_q6_a">2人</string>
    <string name="quiz_q6_b">4人</string>
    <string name="quiz_q6_c">6人</string>
    <string name="quiz_q6_d">8人</string>

    <string name="quiz_q7_question">ゲームの世界を自由に探索できるモードはどれですか？</string>
    <string name="quiz_q7_a">タイムアタック</string>
    <string name="quiz_q7_b">ふうせんバトル</string>
    <string name="quiz_q7_c">グランプリ</string>
    <string name="quiz_q7_d">フリーラン</string>

    <string name="quiz_q8_question">次のうち、『マリオカート ワールド』で初登場の新コースはどれですか？</string>
    <string name="quiz_q8_a">トロフィーシティ</string>
    <string name="quiz_q8_b">チョコマウンテン</string>
    <string name="quiz_q8_c">キノピオファクトリー</string>
    <string name="quiz_q8_d">ディノディノジャングル</string>

    <string name="quiz_q9_question">レースがファイナルラップに入ると、通常BGMはどのように変化しますか？</string>
    <string name="quiz_q9_a">すべてのBGMが即座に停止する</string>
    <string name="quiz_q9_b">表彰式のBGMに切り替わる</string>
    <string name="quiz_q9_c">テンポの速いファイナルラップ版に切り替わる</string>
    <string name="quiz_q9_d">コースの序曲から再生し直す</string>

    <string name="quiz_q10_question">あなたがこれから解放するコース名と、所属するグランプリカップはどれですか？</string>
    <string name="quiz_q10_a">クッパキャッスル（サンダーカップ）</string>
    <string name="quiz_q10_b">レインボーロード（スペシャルカップ）</string>
    <string name="quiz_q10_c">ロゼッタてんもんだい（スターカップ）</string>
    <string name="quiz_q10_d">ピーチスタジアム（こうらカップ）</string>

